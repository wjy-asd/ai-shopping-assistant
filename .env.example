# Copy to .env for local use and fill in real values. Never commit .env.

# MySQL
MYSQL_URL=jdbc:mysql://localhost:3306/ai_xiaogou?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# MongoDB is only required when AI_MEMORY_STORE=mongodb.
MONGODB_URI=mongodb://localhost:27017/ai_xiaogou
AI_MEMORY_STORE=in-memory

# Alibaba Cloud Model Studio / DashScope key used by chat and embeddings.
DASHSCOPE_API_KEY=sk-your-dashscope-key
